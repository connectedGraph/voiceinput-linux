{
  "name": "mimo-asr",
  "version": "1.0.0",
  "description": "MiMo-V2.5-ASR 桌面语音输入助手：托盘常驻、按住说话、松手整段注入",
  "main": "src/main.js",
  "bin": { "mimo-asr": "bin/mimo-asr.js" },
  "scripts": {
    "start": "electron .",
    "dev": "MIMO_DEBUG=1 electron .",
    "test:clipboard": "env -u WAYLAND_DISPLAY xvfb-run -a electron tests/clipboard.cjs --no-sandbox --ozone-platform=x11 --disable-gpu",
    "test:fallback": "env -u WAYLAND_DISPLAY xvfb-run -a electron tests/fallback.cjs --no-sandbox --ozone-platform=x11 --disable-gpu",
    "test:input": "node tests/native-input.cjs",
    "test:codex": "node tests/codex-input.cjs",
    "icons": "node scripts/gen-icons.js",
    "trim": "bash scripts/trim-runtime.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.0.0"
  }
}
